# ─────────────────────────────────────────────
# 資料：原始檔不進版控
# 檔案大、且來源（關務署 / 主計總處）有使用條款。
# 取得方式記錄在 README，讓他人可自行重建。
# ─────────────────────────────────────────────
data/raw/**
data/interim/**
data/processed/**
!data/**/.gitkeep

# 例外：下載紀錄要進版控。
# 資料本身是人工下載的（兩個官方系統都有驗證碼），別人拿到 repo
# 只能靠這份 MANIFEST 知道該下載什麼、以及數字是怎麼來的。
!data/raw/MANIFEST.md

*.csv
*.tsv
*.xls
*.xlsx
*.parquet
*.feather
*.db
*.sqlite3

# 測試用的小樣本 fixture 例外，要進版控
!tests/fixtures/**

# ─────────────────────────────────────────────
# 模型檔
# ─────────────────────────────────────────────
models/**
!models/.gitkeep
*.pkl
*.joblib
*.h5
*.onnx
*.cbm
*.txt.model

# ─────────────────────────────────────────────
# Python
# ─────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
build/
dist/
*.egg-info/
.eggs/

# 虛擬環境
venv/
.venv/
env/
ENV/

# 測試與工具快取
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.tox/

# ─────────────────────────────────────────────
# Jupyter
# ─────────────────────────────────────────────
.ipynb_checkpoints/
*/.ipynb_checkpoints/*
profile_default/
ipython_config.py

# ─────────────────────────────────────────────
# 機密與環境變數
# ─────────────────────────────────────────────
.env
.env.*
!.env.example
secrets.yaml
credentials.json

# ─────────────────────────────────────────────
# 編輯器 / 作業系統
# ─────────────────────────────────────────────
.idea/
.vscode/
*.swp
*~
.DS_Store
Thumbs.db
desktop.ini

# ─────────────────────────────────────────────
# 第三方套件產出
# ─────────────────────────────────────────────
# Prophet / cmdstan 編譯殘留
*.stan
*.hpp
/tmp/
